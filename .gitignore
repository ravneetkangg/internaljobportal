# ============================================
# .gitignore for Internal Job Portal
# Covers: React (Node/Vite), .NET 4.8 / Visual Studio, OS files
# ============================================

# ── Node / Frontend Dependencies & Builds ──
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite / React build outputs
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
*.local

# ── .NET / Visual Studio Build & Temp Files ──
bin/
obj/
*/bin/
*/obj/
backend/InternalJobPortal.Api/bin/
backend/InternalJobPortal.Api/obj/

# Visual Studio working files & cache
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.pidb
*.booproj
*.svclog

# NuGet packages folder (if downloaded locally)
packages/
backend/packages/
*.nupkg
!packages.config

# ── Logs & Databases ──
*.log
*.sqlite
*.db

# ── Environment & Secrets ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── OS Generated Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── IDE & Editor Folders ──
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
